---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Fundación Ciudadanía Inteligente</title>
  </head>
  <body class="m-0 min-h-full w-full">
    <div class="flex h-[41px] items-center bg-fci-blue">
      <div class="mx-auto flex w-full max-w-[1440px] items-center justify-between px-6 lg:px-20">
        <span class="font-work-sans text-xs text-white md:text-sm lg:text-[20px]">En america latina y el Caribe</span>
        <div class="flex gap-1" aria-label="Selector de idioma">
          <button class="rounded px-1 text-[16px] leading-[19px] font-normal text-white/60 hover:text-white">PT</button>
          <button class="rounded px-1 text-[16px] leading-[19px] font-normal text-white/60 hover:text-white">EN</button>
          <button class="rounded px-1 text-[16px] leading-[19px] font-extrabold text-white">ES</button>
        </div>
      </div>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html {
    height: 100%;
  }
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
