---
const currentPath = Astro.url?.pathname || '/';

const leftLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/transparencia', label: 'Transparencia' },
];
const rightLinks = [
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/novedades', label: 'Novedades' },
  { href: '/contacto', label: 'Contacto' },
];

const allLinks = [...leftLinks, ...rightLinks];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  class="relative z-50 h-[96px] rounded-b-[20px] bg-white shadow-[0px_4px_5px_0px_rgba(0,38,255,0.2)]"
  x-data="{ open: false }"
>
  <div class="relative mx-auto flex h-full max-w-[1444px] items-center justify-between px-6 lg:px-20">
    <!-- Left nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {leftLinks.map((link) => (
        <a
          href={link.href}
          class={`inline-flex h-6 items-center justify-center px-3 py-0.5 text-base font-medium leading-[19px] transition-colors ${
            isActive(link.href)
              ? 'rounded bg-[#DA00FF] font-semibold text-white'
              : 'text-[#0026FF] hover:text-[#DA00FF]'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Logo (centered) -->
    <a href="/" class="shrink-0 lg:absolute lg:left-1/2 lg:-translate-x-1/2" aria-label="Ciudadanía Inteligente - Inicio">
      <img src="/logo-ci.svg" alt="Ciudadanía Inteligente" class="h-[38px] w-auto" width="134" height="38" />
    </a>

    <!-- Right nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {rightLinks.map((link) => (
        <a
          href={link.href}
          class={`inline-flex h-6 items-center justify-center px-3 py-0.5 text-base font-medium leading-[19px] transition-colors ${
            isActive(link.href)
              ? 'rounded bg-[#DA00FF] font-semibold text-white'
              : 'text-[#0026FF] hover:text-[#DA00FF]'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button
      @click="open = !open"
      class="ml-auto flex lg:hidden"
      aria-label="Abrir menú"
    >
      <svg :class="open ? 'hidden' : 'block'" class="h-6 w-6 text-[#0026FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg :class="open ? 'block' : 'hidden'" class="h-6 w-6 text-[#0026FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <nav
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="border-t border-gray-100 bg-white px-6 pb-6 lg:hidden"
    x-cloak
    aria-label="Menú móvil"
  >
    <div class="flex flex-col items-center gap-2 pt-4">
      {allLinks.map((link) => (
        <a
          href={link.href}
          class={`rounded px-3 py-2 text-base font-medium transition-colors ${
            isActive(link.href)
              ? 'bg-[#DA00FF] font-semibold text-white'
              : 'text-[#0026FF] hover:bg-[#DA00FF]/10'
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>
