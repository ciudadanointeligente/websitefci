---
import Layout from '../layouts/Layout.astro';
import logoUe from '../assets/images/logo-ue.webp';
import logoPackard from '../assets/images/logo-packard.webp';
import logoFes from '../assets/images/logo-fes.webp';
import logoUndef from '../assets/images/logo-undef.webp';
import logoLuminate from '../assets/images/logo-luminate.webp';
import logoOpenSociety from '../assets/images/logo-open-society.webp';
import logoIdrc from '../assets/images/logo-idrc.webp';
import logoOxfam from '../assets/images/logo-oxfam.webp';
import logoAvina from '../assets/images/logo-avina.webp';
import logoNed from '../assets/images/logo-ned.webp';
import logoAecid from '../assets/images/logo-aecid.webp';
import logoKaribu from '../assets/images/logo-karibu.webp';
---

<Layout>
  <section class="relative -mt-[15px] z-0 overflow-hidden bg-fci-blue">
    <div class="relative mx-auto max-w-[1440px] px-6 pb-16 pt-12 lg:px-20 lg:pb-24 lg:pt-16">
      <div class="mb-5">
        <span class="inline-block rounded bg-fci-lightblue px-5 py-2 font-work-sans text-[14px] font-medium tracking-[0.56px] uppercase text-fci-blue">
          <a href="/" class="text-fci-blue underline hover:no-underline">Inicio</a> / Transparencia
        </span>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1fr_610px]">
        <div>
          <h1 class="mb-4 font-work-sans text-[48px] font-black uppercase leading-[1] text-white md:text-[60px]">
            transparencia
          </h1>
        </div>
        <div class="flex items-center">
          <p class="font-work-sans text-[20px] font-medium leading-snug text-white md:text-[24px]">
            <strong>Creemos que la transparencia fortalece la democracia.</strong> <span class="text-fci-green">Por eso ponemos a disposición de todas las personas información clara sobre cómo nos financiamos, quiénes apoyan nuestro trabajo y qué resultados logramos cada año.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-[1440px] px-6 py-16 lg:px-20">
      <div class="grid gap-8 lg:grid-cols-[325px_1fr]">
        <a
          href="#como-nos-financiamos"
          class="inline-flex h-[52px] items-center justify-center rounded bg-fci-darkpurple px-6 font-work-sans text-[24px] font-bold text-white transition-colors hover:bg-fci-purple"
        >
          ¿Cómo nos financiamos?
        </a>
        <p class="font-work-sans text-[16px] leading-relaxed text-black md:text-[20px]">
          Nos financiamos principalmente a través de la postulación de proyectos a entidades internacionales y organismos de cooperación. También generamos acciones de cambio a través de alianzas con instituciones públicas y otras organizaciones de sociedad civil.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-[1440px] px-6 py-16 lg:px-20" x-data="{ activeTab: 'memorias' }">
      <h2 class="text-center font-work-sans text-[32px] font-extrabold uppercase text-fci-mediumblue md:text-[40px]">
        Reportes anuales
      </h2>
      <p class="mt-4 text-center font-work-sans text-[16px] leading-relaxed text-black md:text-[20px]">
        Accede a nuestras memorias y otros documentos importantes de nuestra gestión.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <button
          class="inline-flex h-[52px] items-center justify-center rounded px-6 font-work-sans text-[27px] font-bold text-white transition-colors"
          :class="activeTab === 'memorias' ? 'bg-fci-darkpurple' : 'bg-fci-purple opacity-70'"
          @click="activeTab = 'memorias'"
        >
          Memorias
        </button>
        <button
          class="inline-flex h-[41px] items-center justify-center rounded px-6 font-work-sans text-[27px] font-bold text-white transition-colors"
          :class="activeTab === 'protocolos' ? 'bg-fci-darkpurple' : 'bg-fci-purple opacity-70'"
          @click="activeTab = 'protocolos'"
        >
          Protocolos y funcionamiento
        </button>
      </div>

      <div class="mt-8">
        <div x-show="activeTab === 'memorias'" class="columns-2 space-y-3">
          <a href="https://ciudadaniai.org/assets/attachments/memoria_fci-2023.pdf" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2023</a>
          <a href="https://ciudadaniai.org/assets/attachments/memoria_fci-2022.pdf" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2022</a>
          <a href="https://ciudadaniai.org/assets/attachments/memoria_fci-2021.pdf" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2021</a>
          <a href="https://ciudadaniai.org/assets/attachments/memoria_fci_2020.pdf" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2020</a>
          <a href="https://drive.google.com/file/d/1qNzq4byMuaICKbZ4fpWoAhSjEMAsv-64/view?usp=sharing" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2019</a>
          <a href="https://ciudadaniai.org/assets/attachments/memoria_ciudadaniai_2018.pdf" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2018</a>
          <a href="https://ciudadaniai.org/assets/attachments/memoria_fci-2017.pdf" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2017</a>
          <a href="https://drive.google.com/file/d/1EvRXPz1Y_zMjCDk5eO5tuVfWTAYpvGR3/view?usp=sharing" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2016</a>
          <a href="https://drive.google.com/file/d/1zjuWsPfRm6jDBX37LZupKzz7J_Fwl_S0/view?usp=sharing" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2015</a>
          <a href="https://drive.google.com/file/d/1hicIQKKpTjye60v_CIPIj4u8YKSaGoxd/view?usp=sharing" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Memoria 2014</a>
        </div>
        <div x-show="activeTab === 'protocolos'" class="space-y-3">
          <a href="https://docs.google.com/document/d/1_mBOB2RZp1YOEuxtUMZjU1HiFIerAv7geWznlxQa9_w/edit?usp=sharing" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Código de conducta</a>
          <a href="https://docs.google.com/document/d/1dODbhkGMZN_KP-a5sG9e452mxOalQstcBZhhYKE4wqI/edit?tab=t.0#heading=h.fdemtev2ig9o" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Manifiesto y Protocolo para Promover la Igualdad de Género</a>
          <a href="https://docs.google.com/document/d/1hthbZDJ8f_2EeS5de9tlF1_BZ6fYJonpT8gKdMzcmMo/edit?tab=t.0#heading=h.t7x2w3gvdihb" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Protocolo para la Prevención y Abordaje del Acoso Sexual</a>
          <a href="https://docs.google.com/document/d/1eLWEcZ1onUU2TYg2x4lsrYfbyVmysdmDcV61cDGfsXs/edit?tab=t.0" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Manual de Prevención de Conflictos de Interés</a>
          <a href="https://ciudadaniai.org/assets/attachments/estatutos-FCI.pdf" class="block font-space-mono text-[18px] text-[#334FFF] underline transition-colors hover:text-fci-blue md:text-[20px]">Nuestros estatutos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-[1440px] px-6 pb-16 lg:px-20">
      <h2 class="mb-8 text-center font-work-sans text-[32px] font-extrabold uppercase text-fci-mediumblue md:text-[40px]">
        Quiénes apoyan nuestro trabajo
      </h2>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-[1440px] px-6 pb-20 lg:px-20">
      <h2 class="mb-10 text-center font-work-sans text-[32px] font-extrabold uppercase text-fci-mediumblue md:text-[40px]">
        transparencia financiera
      </h2>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        <div class="flex items-center justify-center"><img src={logoUe.src} alt="Unión Europea" class="h-auto max-h-[105px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoPackard.src} alt="Packard Foundation" class="h-auto max-h-[82px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoFes.src} alt="FES" class="h-auto max-h-[77px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoUndef.src} alt="UNDEF" class="h-auto max-h-[59px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoLuminate.src} alt="Luminate" class="h-auto max-h-[93px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoOpenSociety.src} alt="Open Society" class="h-auto max-h-[99px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoIdrc.src} alt="IDRC" class="h-auto max-h-[80px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoOxfam.src} alt="Oxfam" class="h-auto max-h-[73px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoAvina.src} alt="Avina" class="h-auto max-h-[55px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoNed.src} alt="NED" class="h-auto max-h-[63px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoAecid.src} alt="AECID" class="h-auto max-h-[55px] w-auto object-contain" loading="lazy" /></div>
        <div class="flex items-center justify-center"><img src={logoKaribu.src} alt="Karibu" class="h-auto max-h-[55px] w-auto object-contain" loading="lazy" /></div>
      </div>
    </div>
  </section>
</Layout>
