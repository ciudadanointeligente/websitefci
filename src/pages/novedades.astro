---
import Layout from '../layouts/Layout.astro';
import fondoAzul from '../assets/images/fondo-azul.webp';
import pubAbreAlcaldias from '../assets/images/pub-abre-alcaldias.webp';
import pubHidrogenoVerdePB from '../assets/images/pub-hidrogeno-verde-pb.webp';
import pubDemocraciaKit from '../assets/images/pub-democracia-kit.webp';
import pubSeguridadDigital from '../assets/images/pub-seguridad-digital.webp';
import pubLibroAbreAlcaldias from '../assets/images/pub-libro-abre-alcaldias.webp';
import pubDemocraciaAmbiental from '../assets/images/pub-democracia-ambiental.webp';
import pubLabCivico from '../assets/images/pub-lab-civico.webp';
import pubColectivaMexico from '../assets/images/pub-colectiva-mexico.webp';
import pubHidrogenoVerdeQE from '../assets/images/pub-hidrogeno-verde-que-es.webp';
---

<Layout>
  <section class="relative overflow-hidden" style="background: linear-gradient(180deg, #0026FF 50%, rgba(0, 38, 255, 0.4) 97%);">
    <img
      src={fondoAzul.src}
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-30"
    />

    <div class="relative mx-auto max-w-[1440px] px-6 pb-16 pt-12 lg:px-20 lg:pb-24 lg:pt-16">
      <div class="mb-5">
        <span class="inline-block rounded bg-fci-lightblue px-5 py-2 font-work-sans text-[14px] font-medium tracking-[0.56px] uppercase text-fci-blue">
          <a href="/" class="text-fci-blue underline hover:no-underline">Inicio</a> / novedades
        </span>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1fr_610px]">
        <div>
          <h1 class="mb-4 font-work-sans text-[48px] font-black uppercase leading-[1] text-white md:text-[60px]">
            novedades
          </h1>
        </div>
        <div class="flex items-center">
          <p class="font-work-sans text-[20px] font-bold leading-snug text-white md:text-[24px]">
            Conoce nuestras investigaciones, manuales, columnas y boletines <span class="font-medium text-fci-green">que analizan y proponen caminos para una democracia más participativa, justa y sostenible.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-[1440px] px-6 py-10 lg:px-20">
      <div class="flex flex-wrap items-center gap-4">
        <span class="font-work-sans text-[20px] font-bold text-fci-blue">Filtrar por:</span>
        <button class="inline-flex items-center gap-2 rounded-[6px] bg-fci-green px-5 py-2 font-work-sans text-[16px] text-black">
          Producto
          <svg width="14" height="8" viewBox="0 0 14 8" fill="none"><path d="M1 1L7 7L13 1" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="inline-flex items-center gap-2 rounded-[6px] bg-fci-green px-5 py-2 font-work-sans text-[16px] text-black">
          Temática
          <svg width="14" height="8" viewBox="0 0 14 8" fill="none"><path d="M1 1L7 7L13 1" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-[1440px] px-6 pb-20 lg:px-20">
      <h2 class="text-center font-work-sans text-[32px] font-extrabold uppercase text-fci-mediumblue md:text-[40px]">
        nuestras noticias
      </h2>
      <p class="mt-2 text-center font-work-sans text-[20px] text-[#373737]">
        Resultado de búsqueda por: <strong class="font-bold">Investigaciones</strong>
      </p>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubAbreAlcaldias.src} alt="Abre Alcaldías" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Abre Alcaldías - Desconfianza en instituciones públicas
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubSeguridadDigital.src} alt="Escuela de Activismo Digital" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Escuela de Activismo Digital - Seguridad digital
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubLabCivico.src} alt="LabCívico" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              LabCívico - Manual Metodológico
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubHidrogenoVerdePB.src} alt="Policy Brief Hidrógeno Verde" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Policy Brief Hidrógeno Verde
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubLibroAbreAlcaldias.src} alt="Libro Abre Alcaldías" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Libro Abre Alcaldías
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubColectivaMexico.src} alt="Evento Colectiva México" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Evento Colectiva México
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubDemocraciaKit.src} alt="Democracia Kit de Abre Alcaldías" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Democracia Kit de Abre Alcaldías
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubDemocraciaAmbiental.src} alt="Democracia Ambiental" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Democracia Ambiental: Donde medio ambiente y democracia se encuentran
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>

        <article class="flex flex-col overflow-hidden rounded-[10px] bg-white shadow-[0px_5.72px_9.53px_3.81px_rgba(0,0,0,0.15)] transition-transform hover:scale-[1.02]">
          <img src={pubHidrogenoVerdeQE.src} alt="Hidrógeno Verde" class="mx-auto mt-0 h-[322px] w-[293px] rounded-[10px] object-cover" loading="lazy" />
          <div class="flex flex-1 flex-col items-center justify-between px-5 pb-5 pt-4">
            <h3 class="text-center font-work-sans text-[20px] font-medium text-fci-mediumblue">
              Hidrógeno Verde - ¿Qué es y cómo se usa?
            </h3>
            <a href="#" class="mt-4 inline-flex items-center gap-2 rounded-[10px] border border-fci-purple px-4 py-3 font-work-sans text-[18px] text-fci-purple transition-colors hover:bg-fci-purple/5">
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M2 12V15H6L15 6L11 2L2 11V12ZM4.5 12.5L12 5L13 6L5.5 13.5H4.5V12.5Z" fill="#DA00FF"/><path d="M15 2H12V4H16V8H18V2H15Z" fill="#DA00FF"/></svg>
              DESCARGAR PDF
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>
